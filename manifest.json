{
  "manifest_version": 3,
  "name": "Shelf Index",
  "version": "1.0.0",
  "description": "Lightweight shelf index helper for signed-in workspace pages.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://odoo.codingcops.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shelf Index",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://odoo.codingcops.com/*"],
      "js": ["theme.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://odoo.codingcops.com/*"],
      "js": ["hours.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/shelf-index.svg"],
      "matches": ["https://odoo.codingcops.com/*"]
    }
  ]
}
